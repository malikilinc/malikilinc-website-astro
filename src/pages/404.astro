---
import Layout from "@/layouts/Layout.astro";
import { ArrowLeft } from "lucide-react";
---

<Layout title="Sayfa Bulunamadı | 404">
  <div class="min-h-screen flex items-center justify-center px-4">
    <div class="text-center space-y-6 max-w-md">
      <h1 class="text-8xl font-black text-white/20 select-none">404</h1>
      <h2 class="text-2xl font-bold text-white">Aradığınız Sayfa Bulunamadı</h2>
      <p class="text-white/60 text-sm">
        Aradığınız sayfa silinmiş, adı değiştirilmiş veya geçici olarak erişilemez durumda olabilir.
      </p>
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-accent text-white font-medium hover:bg-accent/80 transition-all"
        >
          <ArrowLeft className="h-4 w-4" />
          Ana Sayfaya Dön
        </a>
      </div>
    </div>
  </div>
</Layout>
