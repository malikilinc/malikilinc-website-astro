---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { getCategoryBySlug } from "@/data/categories";
import { ArrowLeft, ArrowRight, Clock, Calendar } from "lucide-react";
import { parseDate } from "@/lib/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const category = getCategoryBySlug(post.data.category);

const allPosts = await getCollection("blog");
const sortedPosts = allPosts
  .filter((p) => p.data.published)
  .sort((a, b) => parseDate(b.data.date) - parseDate(a.data.date));

const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);
const previousPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
---

<Layout
  title={`${post.data.title} | mAli`}
  description={post.data.description}
  image={post.data.image}
>
  <div class="min-h-screen pt-24">
    <article class="relative section-glow-top pt-6 pb-16 px-4 md:px-8">
      <div class="max-w-3xl mx-auto">
      {/* Geri butonu */}
      <div class="mb-8">
        <a href="/blog" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-white/70 hover:text-white hover:bg-white/10 transition-all text-sm">
          <ArrowLeft className="h-4 w-4" />
          Blog
        </a>
      </div>

      {/* Üst bilgi */}
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-4 mb-4">
          {category && (
            <a
              href={`/blog?category=${post.data.category}`}
              class="text-xs px-3 py-1 rounded-full bg-accent/20 text-accent border border-accent/30 hover:bg-accent/30 transition-colors"
            >
              {category.title}
            </a>
          )}
          <span class="flex items-center gap-1.5 text-sm text-white/50">
            <Calendar className="h-4 w-4 inline" />
            {post.data.date}
          </span>
          <span class="flex items-center gap-1.5 text-sm text-white/50">
            <Clock className="h-4 w-4 inline" />
            {post.data.readingTime || 3} dk okuma
          </span>
        </div>

        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">
          {post.data.title}
        </h1>
        <p class="text-white/60 text-base md:text-lg">
          {post.data.description}
        </p>
      </header>

      {/* Hero görseli */}
      {post.data.image && (
        <div class="relative aspect-video rounded-2xl overflow-hidden mb-10 border border-white/10">
          <img
            src={post.data.image}
            alt={post.data.title}
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
      )}

      {/* MDX İçerik */}
      <div class="prose-custom">
        <Content />
      </div>

      {/* Etiketler */}
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-10 pt-6 border-t border-white/10">
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span
                class="text-xs px-3 py-1 rounded-full bg-white/5 border border-white/10 text-white/50"
              >
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

      {/* Önceki/Sonraki yazı navigasyonu */}
      {(previousPost || nextPost) && (
        <div class="mt-10 pt-6 border-t border-white/10 grid grid-cols-1 md:grid-cols-2 gap-3">
          {previousPost ? (
            <a href={`/blog/${previousPost.id.replace(/\.(md|mdx)$/, "")}`} class="p-4 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all flex flex-col justify-between">
              <span class="inline-flex items-center gap-2 text-white/50 text-xs mb-1">
                <ArrowLeft className="h-4 w-4" />
                Önceki Yazı
              </span>
              <span class="line-clamp-1 text-sm md:text-base text-white font-medium">
                {previousPost.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden md:block" />
          )}

          {nextPost ? (
            <a href={`/blog/${nextPost.id.replace(/\.(md|mdx)$/, "")}`} class="p-4 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all flex flex-col justify-between text-right">
              <span class="inline-flex items-center justify-end gap-2 text-white/50 text-xs mb-1">
                Sonraki Yazı
                <ArrowRight className="h-4 w-4" />
              </span>
              <span class="line-clamp-1 text-sm md:text-base text-white font-medium">
                {nextPost.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden md:block" />
          )}
        </div>
      )}
    </div>
  </article>
</div>
</Layout>
