---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { getProjectCategoryBySlug } from "@/data/projects";
import { ArrowLeft, ExternalLink } from "lucide-react";
import { SiGithub } from "react-icons/si";
import { ProjectMedia } from "@/components/shared/ProjectMedia";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.(md|mdx)$/, "") },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const category = getProjectCategoryBySlug(project.data.category);

const liveUrls =
  project.data.liveUrls && project.data.liveUrls.length > 0
    ? project.data.liveUrls
    : project.data.liveUrl
      ? [{ url: project.data.liveUrl, label: "Canlı Demo" }]
      : [];
---

<Layout
  title={`${project.data.title} | mAli`}
  description={project.data.shortDescription || project.data.description}
  image={project.data.image}
>
  <div class="min-h-screen pt-24">
    <div class="relative section-glow-top pt-6 pb-16 px-4 md:px-8">
      <div class="max-w-4xl mx-auto">
      {/* Geri butonu */}
      <div class="mb-8">
        <a
          href="/projects"
          aria-label="Projeler listesine geri dön"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-white/85 hover:text-white hover:bg-white/10 transition-all text-sm"
        >
          <ArrowLeft className="h-4 w-4" />
          Projeler
        </a>
      </div>

      {/* Proje Görseli */}
      <div class="relative aspect-video rounded-2xl overflow-hidden mb-8 border border-white/10 group">
        <ProjectMedia
          src={project.data.image}
          alt={project.data.title}
          className="object-cover"
          client:load
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent pointer-events-none" />
      </div>

      {/* Proje Bilgileri */}
      <div class="space-y-6">
        {category && (
          <span class="inline-block text-xs px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30">
            {category.title}
          </span>
        )}
        <h1 class="text-3xl md:text-5xl font-bold text-white">
          {project.data.title}
        </h1>
        <p class="text-white/85 text-base md:text-lg leading-relaxed">
          {project.data.description}
        </p>

        {/* Teknolojiler */}
        {project.data.technologies && project.data.technologies.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {project.data.technologies.map((tech) => (
              <span
                class="text-sm px-3 py-1.5 rounded-full bg-white/10 border border-white/15 text-white/85"
              >
                {tech}
              </span>
            ))}
          </div>
        )}

        {/* Linkler */}
        <div class="flex flex-wrap gap-4 pt-4">
          {liveUrls.map((liveUrl) => (
            <a
              href={liveUrl.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${liveUrl.label || "Canlı Demo"} - ${project.data.title}`}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-accent text-white font-medium hover:bg-accent/80 transition-all shadow-lg"
            >
              <ExternalLink className="h-4 w-4" />
              {liveUrl.label || "Canlı Demo"}
            </a>
          ))}
          {project.data.githubUrl && (
            <a
              href={project.data.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`GitHub Proje Deposu - ${project.data.title}`}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white font-medium hover:bg-white/20 transition-all"
            >
              <SiGithub className="h-4 w-4" />
              GitHub
            </a>
          )}
        </div>

        {/* MDX İçerik */}
        <div class="prose-custom pt-8 border-t border-white/10">
          <Content />
        </div>

        {/* Ek görseller (varsa) */}
        {project.data.images && project.data.images.length > 0 && (
          <div class="space-y-4 pt-8">
            <h2 class="text-xl font-semibold text-white">
              Proje Görselleri
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {project.data.images.map((img, index) => (
                <div
                  class="relative aspect-video rounded-xl overflow-hidden border border-white/10"
                >
                  <ProjectMedia
                    src={img}
                    alt={`${project.data.title} - Görsel ${index + 1}`}
                    className="object-cover"
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</div>
</Layout>
